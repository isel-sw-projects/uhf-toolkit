@page "/streaming-input"
@rendermode InteractiveServer

<PageTitle>Streaming Input</PageTitle>

<h1>Streaming Input</h1>

<p>Trace of the <em>streaming-input</em> example: content arriving in chunks while the input
    stays active - the combination the corpus <em>progressive-load</em> does not exercise (it is
    input-free). In BRHC the stream is an SSE channel emitting successive <code>patch-elements</code>;
    the input sends <code>signal</code>s in a POST that responds with its own patch. Here the
    C# async sequence corresponds to the stream; the input stays interactive during it because
    each <code>StateHasChanged</code> only touches the affected section. <strong>Teaching note:</strong>
    in both models the two channels run in parallel; the difference is who declares them -
    atributos Datastar no HTML vs ciclo async + diff no runtime.</p>

    <div class="demo-box">
        <div class="border rounded p-3 mb-3" style="min-height: 8em; background: #f8f9fa;">
            @if (!chunks.Any())
            {
                <span class="text-muted">Waiting for the stream to start</span>
            }
            @foreach (var c in chunks)
            {
                <div>@((MarkupString)c)</div>
            }
            @if (streamDone)
            {
                <div><strong>stream complete.</strong></div>
            }
        </div>

        <div class="input-group">
            <input class="form-control" @bind="message" placeholder="type during the stream..." />
            <button class="btn btn-primary" @onclick="SendMessage">Send</button>
        </div>

        <div class="mt-3">
            @if (messages.Any())
            {
                <ul class="list-group">
                    @foreach (var m in messages)
                    {
                        <li class="list-group-item py-1">@((MarkupString)m)</li>
                    }
                </ul>
            }
        </div>
    </div>

@code {
    private string message = string.Empty;
    private readonly List<string> chunks = new();
    private readonly List<string> messages = new();
    private bool streamDone;
    private bool streaming;

    // Equivalent to GET /streaming-input/stream: 4 delayed chunks, analogous to the
    // patchElements sequenciais do Kotlin.
    private async Task StartStream()
    {
        if (streaming) return;
        streaming = true;
        streamDone = false;
        chunks.Clear();
        try
        {
            foreach (var chunk in new[] { "chunk A", "chunk B", "chunk C", "chunk D" })
            {
                await Task.Delay(800);
                chunks.Add($"<em>{chunk}</em> received.");
                StateHasChanged();
            }
            await Task.Delay(400);
            streamDone = true;
        }
        finally
        {
            streaming = false;
            StateHasChanged();
        }
    }

    // Equivale ao POST /streaming-input/message: chega DURANTE a stream
    // e entra no log sem a interromper.
    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(message)) return;
        var sent = message;
        message = string.Empty;
        messages.Add($"mensagem recebida durante o stream: <strong>{System.Net.WebUtility.HtmlEncode(sent)}</strong>");
        StateHasChanged();
        await Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        await StartStream();
    }
}