@page "/delete-row"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Delete Row</PageTitle>

<h1>Delete Row</h1>

<p>Trace of the <em>Delete Row</em> example from <code>HtmlFlow-Datastar-Examples</code>. No BRHC o delete envia
    <code>@@delete('/delete-row/{index}')</code> e o servidor remove a linha via <code>morphMode.remove</code>. Aqui a
    removal is an operation on a C# list on the server.</p>

<div class="demo-box">
    <div id="users-table">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < users.Count; i++)
                {
                    var rowIndex = i;
                    <tr>
                        <td>@users[i].Name</td>
                        <td>@users[i].Email</td>
                        <td>
                            <button class="btn btn-danger btn-sm" @onclick="() => Delete(rowIndex)">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button class="btn btn-warning" @onclick="Restore">Reset</button>
</div>

@code {
    private readonly List<User> users =
    [
        new("Joe Smith", "joe@smith.org"),
        new("Angie MacDowell", "angie@macdowell.org"),
        new("Fuqua Tarkenton", "fuqua@tarkenton.org"),
        new("Kim Yee", "kim@yee.org"),
    ];

    private async Task Delete(int index)
    {
        // equivale ao data-on:click="confirm('Are you sure?') && @delete('/delete-row/{index}')"
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure?");
        if (!confirmed)
        {
            return;
        }
        users.RemoveAt(index);
    }

    private void Restore()
    {
        // equivale ao PATCH /delete-row/reset
        users.Clear();
        users.Add(new("Joe Smith", "joe@smith.org"));
        users.Add(new("Angie MacDowell", "angie@macdowell.org"));
        users.Add(new("Fuqua Tarkenton", "fuqua@tarkenton.org"));
        users.Add(new("Kim Yee", "kim@yee.org"));
    }

    private sealed record User(string Name, string Email);
}
